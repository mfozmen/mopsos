# Personal data — never committed. See SECURITY.md.
# The directory's own README is the exception, so the rule is visible in the repo.
private/*
!private/README.md

# The private data repository, if it ever gets cloned in here by mistake.
# It belongs beside this repository, not inside it.
mopsos-data/

# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest/

# Logs
*.log
npm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Generated by `npm run ui`
/ui/

# Screenshots and browser automation output
.playwright-mcp/
*.png
*.jpeg
*.jpg

# Scratch space for agents downloading source documents to read.
.research/

# Playwright snapshots and console logs from browsing. Scratch, and they pick up
# whatever was on the page — bank phone numbers, for one.
.playwright-mcp/
