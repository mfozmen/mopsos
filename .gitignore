# Personal data — never committed. See SECURITY.md.
# The directory's own README is the exception, so the rule is visible in the repo.
private/*
!private/README.md

# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/
.vitest/

# Logs
*.log
npm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
