{
  "name": "mopsos",
  "version": "0.0.0",
  "private": true,
  "description": "Personal investment research tool that keeps score of its own predictions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "due": "tsx src/cli/due.ts",
    "scan:personal-data": "tsx src/cli/scan-personal-data.ts",
    "ui": "tsx src/cli/ui.ts",
    "pdf:text": "tsx src/cli/pdf-text.ts",
    "dev": "tsx src/cli/dev.ts",
    "queue": "tsx src/cli/queue.ts",
    "check:rates": "tsx src/cli/check-rates.ts",
    "read:page": "tsx src/cli/read-page.ts",
    "import:listings": "tsx src/cli/import-listings.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "unpdf": "^1.8.0",
    "yaml": "^2.9.0"
  }
}
