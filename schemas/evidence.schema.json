{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mfozmen/mopsos/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "The raw data a verdict rests on, captured when it was collected. Stored as JSON: it is machine data with no prose, unlike a verdict.",
  "type": "object",
  "required": ["schema_version", "verdict_id", "collected_at", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "verdict_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "collected_at": { "type": "string", "format": "date-time" },
    "sources": {
      "description": "At least one. A verdict resting on nothing is not evidence-backed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "reference", "retrieved_at"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["evds", "tuik", "listing_snapshot", "market_close", "news", "other"]
          },
          "reference": {
            "description": "Series code, basket id, or a stable identifier for the document.",
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri" },
          "observations": {
            "description": "The values as read. Recorded here so the verdict can be re-examined without re-fetching a series that may since have been revised.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["period", "value"],
              "additionalProperties": false,
              "properties": {
                "period": { "type": "string", "minLength": 1 },
                "value": { "type": "number" }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
